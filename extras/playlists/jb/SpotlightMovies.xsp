<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Spotlight</name>
    <match>all</match>
    <rule field="rating" operator="greaterthan">
        <value>6.5</value>
    </rule>
    <rule field="playcount" operator="is">
        <value>0</value>
    </rule>
    <limit>15</limit>
    <order direction="descending">dateadded</order>
</smartplaylist>
