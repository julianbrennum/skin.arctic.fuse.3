<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Top Rated Shows</name>
    <match>all</match>
    <rule field="rating" operator="greaterthan">
        <value>0</value>
    </rule>
    <limit>50</limit>
    <order direction="descending">rating</order>
</smartplaylist>
