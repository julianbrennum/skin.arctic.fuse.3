<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Recently Watched</name>
    <match>all</match>
    <rule field="lastplayed" operator="after">
        <value>2000-01-01</value>
    </rule>
    <limit>30</limit>
    <order direction="descending">lastplayed</order>
</smartplaylist>
